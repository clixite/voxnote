# Secret utilisé pour signer les cookies JWT de session (obligatoire, pas de défaut)
AUTH_SECRET=

# Hash bcrypt du mot de passe unique d'accès (obligatoire, pas de défaut)
APP_PASSWORD_HASH=

# Optionnel, développement local UNIQUEMENT (pnpm dev sur http://localhost).
# Retire l'attribut Secure du cookie de session, sinon posé par défaut :
# `pnpm dev` sert l'app en HTTP simple, et un cookie Secure reçu en clair
# n'est fiable dans aucun navigateur. NE JAMAIS définir cette variable en
# production : elle désactiverait une protection du cookie de session.
# ALLOW_INSECURE_COOKIES=1

# Fournisseur de transcription : groq, openai, ou gladia (défaut: groq)
TRANSCRIBE_PROVIDER=groq

# Clé API Groq (obligatoire si TRANSCRIBE_PROVIDER=groq)
GROQ_API_KEY=

# Clé API OpenAI (obligatoire si TRANSCRIBE_PROVIDER=openai)
OPENAI_API_KEY=

# Clé API Gladia (obligatoire si TRANSCRIBE_PROVIDER=gladia)
GLADIA_API_KEY=

# Token de lecture/écriture Vercel Blob (obligatoire pour le stockage audio)
BLOB_READ_WRITE_TOKEN=

# Secret pour valider les requêtes cron depuis Vercel (obligatoire pour la purge automatique)
CRON_SECRET=
